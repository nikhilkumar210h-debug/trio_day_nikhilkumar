rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/config/admins)
        && request.auth.uid in get(/databases/$(database)/documents/config/admins).data.uids;
    }

    match /posts/{postId} {
      allow read: if signedIn() && (
        resource.data.type == 'post'
        || resource.data.privacy == 'public'
        || resource.data.uid == request.auth.uid
        || (
          resource.data.privacy == 'friends'
          && resource.data.allowedUids is list
          && request.auth.uid in resource.data.allowedUids
        )
      );
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 50
        && request.resource.data.message is string && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 500
        && request.resource.data.type in ['post', 'story', 'voice']
        && (
          request.resource.data.type == 'post'
          || (
            request.resource.data.isStory == true
            && request.resource.data.privacy in ['public', 'friends']
            && request.resource.data.expiresAtMs is number
            && (
              request.resource.data.privacy == 'public'
              || (
                request.resource.data.allowedUids is list
                && request.resource.data.allowedUids.size() <= 500
                && request.auth.uid in request.resource.data.allowedUids
              )
            )
          )
          || (
            request.resource.data.type == 'voice'
            && request.resource.data.isVoice == true
            && request.resource.data.duration is number
            && request.resource.data.duration > 0
            && request.resource.data.duration <= 60
            && request.resource.data.privacy in ['public', 'friends']
            && request.resource.data.expiresAtMs is number
            && request.resource.data.mediaUrl is string
            && (
              request.resource.data.privacy == 'public'
              || (
                request.resource.data.allowedUids is list
                && request.resource.data.allowedUids.size() <= 500
                && request.auth.uid in request.resource.data.allowedUids
              )
            )
          )
        );
      allow update: if false;
      allow delete: if owner(resource.data.uid);
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid
          && request.resource.data.txt is string && request.resource.data.txt.size() > 0
          && request.resource.data.txt.size() < 200 && request.resource.data.name is string;
        allow update, delete: if false;
      }
      match /likes/{likeUid} {
        allow read: if signedIn();
        allow create: if owner(likeUid) && request.resource.data.uid == request.auth.uid;
        allow delete: if owner(likeUid);
        allow update: if false;
      }
      match /moods/{moodUid} {
        allow read: if signedIn();
        allow create: if owner(moodUid) && request.resource.data.uid == request.auth.uid && request.resource.data.mood is string;
        allow delete: if owner(moodUid);
        allow update: if owner(moodUid);
      }
    }

    // Gamification fields that ONLY Cloud Functions / server logic may write.
    // A client-side update that touches any of these keys is rejected.
    function noGamificationWrite() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny([
          'xp', 'level', 'streakCurrent', 'streakBest', 'streakLastDate',
          'weeklyXp', 'monthlyXp', 'badges'
        ]);
    }

    // Allow userId change only if current value is missing (first-time set).
    function canChangeUserId() {
      return !('userId' in resource.data)
        || resource.data.userId == null
        || resource.data.userId == '';
    }

    function validActivityInteraction(value) {
      return value is map
        && value.size() <= 12
        && (
          (
            value.kind == 'quiz'
            && value.question is string
            && value.question.size() > 0
            && value.question.size() <= 500
            && value.options is list
            && value.options.size() == 4
            && value.correct is int
            && value.correct >= 0
            && value.correct <= 3
          )
          || (
            value.kind in ['build','challenge','room']
          )
        );
    }

    match /usersPrivate/{userId} {
      allow read, create, update: if owner(userId);
      allow delete: if owner(userId);
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if owner(userId);
      allow update: if owner(userId)
      && noGamificationWrite()
      && (!request.resource.data.diff(resource.data).affectedKeys().hasAll(['userId']) || canChangeUserId());
      allow delete: if false;
      match /followers/{followerId} {
        allow read: if signedIn();
        allow create: if owner(followerId);
        allow delete: if owner(followerId);
        allow update: if false;
      }
      match /following/{followedId} {
        allow read: if signedIn();
        allow create: if owner(userId) && followedId != request.auth.uid;
        allow delete: if owner(userId);
        allow update: if false;
      }
      match /notifications/{notificationId} {
        allow read, update: if owner(userId);
        // Peer social notifications OR self system/gamification notifications
        allow create: if signedIn()
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.actorName is string
          && request.resource.data.actorName.size() > 0
          && request.resource.data.actorName.size() <= 50
          && request.resource.data.type in [
            'like', 'comment', 'share', 'connect', 'message',
            'badge_earned', 'task_reminder', 'challenge_reminder',
            'streak_warning', 'task_complete'
          ]
          && request.resource.data.read == false
          && request.resource.data.createdAtMs is number
          && (
            userId != request.auth.uid
            || request.resource.data.type in [
              'badge_earned', 'task_reminder', 'challenge_reminder',
              'streak_warning', 'task_complete'
            ]
          );
        allow delete: if owner(userId);
      }
      // Progress-only storage (one doc per period, not per task)
      match /progress/{periodKey} {
        allow read, write: if owner(userId);
      }
      match /activityCompletions/{activityId} {
        allow read: if owner(userId);
        allow create, update: if owner(userId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.activityId == activityId
          && request.resource.data.completedAtMs is number;
        allow delete: if owner(userId);
      }
    }

    match /groupChat/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /privateChats/{chatId}/messages/{messageId} {
      // chatId format: uid1_uid2 where uid1 < uid2 lexicographically
      // Allow access only if current user is one of the two participants
      allow read: if signedIn() && (chatId == request.auth.uid + '_' + request.auth.uid
        || (chatId.matches('^' + request.auth.uid + '_[^_]+$')
          || chatId.matches('^[^_]+_' + request.auth.uid + '$')));
      allow create: if signedIn() && (chatId.matches('^' + request.auth.uid + '_[^_]+$')
          || chatId.matches('^[^_]+_' + request.auth.uid + '$'))
        && request.resource.data.uid == request.auth.uid && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500;
      allow update: if signedIn()
        && (chatId.matches('^' + request.auth.uid + '_[^_]+$')
          || chatId.matches('^[^_]+_' + request.auth.uid + '$'))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen'])
        && request.resource.data.seen is number;
      allow delete: if signedIn()
        && (chatId.matches('^' + request.auth.uid + '_[^_]+$')
          || chatId.matches('^[^_]+_' + request.auth.uid + '$'))
        && resource.data.uid == request.auth.uid;
    }

    // ── Gamification ──────────────────────────────────────────────
    match /config/{docId} {
      allow read: if signedIn();
      allow write: if false; // Console-only (admins list)
    }

    match /taskTemplates/{templateId} {
      allow read: if signedIn();
      // Users create personal templates; admins (or first-time system seed via merge) manage system ones
      allow create: if signedIn()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && (
          isAdmin()
          || (
            request.resource.data.createdBy == request.auth.uid
            && request.resource.data.isSystem != true
          )
          || (
            // Allow seeding known system template docs once (createdBy system)
            request.resource.data.isSystem == true
            && request.resource.data.createdBy == 'system'
          )
        );
      allow update: if signedIn() && (
        isAdmin()
        || (resource.data.createdBy == request.auth.uid && resource.data.isSystem != true)
      );
      allow delete: if isAdmin()
        || (signedIn() && resource.data.createdBy == request.auth.uid && resource.data.isSystem != true);
    }

    match /badges/{badgeId} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /leaderboards/{boardId} {
      allow read: if signedIn();
      // Leaderboard documents are server-managed only.
      // No authenticated client may create, update, or delete them directly.
      // All leaderboard mutations must go through Cloud Functions / Admin SDK.
      allow write: if false;
    }

    match /communityTasks/{taskId} {
      allow read: if signedIn();
      // Any authenticated user can create community / challenge / seasonal from templates
      allow create: if signedIn()
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.kind in ['community', 'challenge', 'seasonal']
        && request.resource.data.activityType in ['puzzle','build','learn','challenge','game']
        && request.resource.data.category is string
        && request.resource.data.category.size() > 0
        && request.resource.data.category.size() <= 60
        && request.resource.data.durationMin is number
        && request.resource.data.durationMin >= 5
        && request.resource.data.durationMin <= 180
        && request.resource.data.difficulty in ['Easy','Medium','Hard']
        && request.resource.data.endAtMs is number
        && request.resource.data.expiresInDays in [7,14,21,30,40]
        && request.resource.data.startAtMs is number
        && request.resource.data.startAtMs <= request.resource.data.endAtMs
        && request.resource.data.status == 'active'
        && request.resource.data.joins == 0
        && request.resource.data.likes == 0
        && request.resource.data.comments == 0
        && request.resource.data.completions == 0
        && request.resource.data.featured == false
        && request.resource.data.hidden == false
        && validActivityInteraction(request.resource.data.interaction);
      allow update: if signedIn() && (
        isAdmin()
        || (
          resource.data.creatorUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title','description','icon','activityType','category','mechanic',
            'durationMin','difficulty','goal','instructions','expiresInDays',
            'startAtMs','endAtMs','templateId','metric','target','xpReward','interaction'
          ])
          && request.resource.data.activityType in ['puzzle','build','learn','challenge','game']
          && request.resource.data.category is string
          && request.resource.data.category.size() > 0
          && request.resource.data.category.size() <= 60
          && request.resource.data.durationMin is number
          && request.resource.data.durationMin >= 5
          && request.resource.data.durationMin <= 180
          && request.resource.data.difficulty in ['Easy','Medium','Hard']
          && request.resource.data.endAtMs is number
          && request.resource.data.expiresInDays in [7,14,21,30,40]
          && (!('interaction' in request.resource.data) || validActivityInteraction(request.resource.data.interaction))
        )
      );
      allow delete: if isAdmin() || (signedIn() && resource.data.creatorUid == request.auth.uid);

      match /members/{memberUid} {
        allow read: if signedIn();
        allow create, delete: if owner(memberUid);
        allow update: if false;
      }
      match /likes/{likeUid} {
        allow read: if signedIn();
        allow create, delete: if owner(likeUid);
        allow update: if false;
      }
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.txt is string
          && request.resource.data.txt.size() > 0
          && request.resource.data.txt.size() < 200;
        allow update, delete: if false;
      }
      match /completions/{uid} {
        allow read: if signedIn();
        allow create: if owner(uid)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.atMs is number
          && (
            get(/databases/$(database)/documents/communityTasks/$(taskId)).data.activityType in ['build','game']
            || !('interaction' in get(/databases/$(database)/documents/communityTasks/$(taskId)).data)
            || (
              get(/databases/$(database)/documents/communityTasks/$(taskId)).data.activityType == 'challenge'
              && request.resource.data.score is int
              && request.resource.data.score >= 3
              && request.resource.data.score <= 5
              && request.resource.data.proofText is string
              && request.resource.data.proofText.size() >= 20
              && request.resource.data.proofText.size() <= 500
            )
            || (
              request.resource.data.answerIndex is int
              && request.resource.data.answerIndex >= 0
              && request.resource.data.answerIndex <= 3
              && request.resource.data.proofText is string
              && request.resource.data.proofText.size() >= 20
              && request.resource.data.proofText.size() <= 500
              && (
                !('interaction' in get(/databases/$(database)/documents/communityTasks/$(taskId)).data)
                || get(/databases/$(database)/documents/communityTasks/$(taskId)).data.interaction.kind != 'quiz'
                || request.resource.data.answerIndex == get(/databases/$(database)/documents/communityTasks/$(taskId)).data.interaction.correct
              )
            )
          );
        allow update, delete: if false;
      }
      match /ratings/{ratingUid} {
        allow read: if signedIn();
        allow create, update: if owner(ratingUid)
          && exists(/databases/$(database)/documents/communityTasks/$(taskId)/completions/$(request.auth.uid))
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.overall is number
          && request.resource.data.overall >= 1 && request.resource.data.overall <= 5
          && request.resource.data.fun is number
          && request.resource.data.fun >= 1 && request.resource.data.fun <= 5
          && request.resource.data.useful is number
          && request.resource.data.useful >= 1 && request.resource.data.useful <= 5
          && request.resource.data.teamwork is number
          && request.resource.data.teamwork >= 1 && request.resource.data.teamwork <= 5;
        allow delete: if owner(ratingUid);
      }
    }
    match /rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.maxPlayers in [2,3,4,6]
        && request.resource.data.activitySource in ['catalog','community']
        && request.resource.data.activityType in ['puzzle','build','learn','challenge','game']
        && request.resource.data.challengeId is string
        && request.resource.data.challengeId.size() > 0
        && request.resource.data.challengeId.size() <= 120
        && request.resource.data.activityTitle is string
        && request.resource.data.activityTitle.size() > 0
        && request.resource.data.activityTitle.size() <= 100
        && request.resource.data.memberCount == 1
        && request.resource.data.expiresAtMs is number
        && request.resource.data.expiresAtMs > request.time.toMillis()
        && request.resource.data.status == 'open';
      allow update: if signedIn() && (
        (
          resource.data.hostUid == request.auth.uid
          && request.resource.data.hostUid == resource.data.hostUid
          && request.resource.data.activityType == resource.data.activityType
          && request.resource.data.activitySource == resource.data.activitySource
          && request.resource.data.challengeId == resource.data.challengeId
          && request.resource.data.expiresAtMs == resource.data.expiresAtMs
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','status','endedAtMs'])
        )
        || (
          get(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)).exists()
          && request.resource.data.hostUid == resource.data.hostUid
          && request.resource.data.activityType == resource.data.activityType
          && request.resource.data.activitySource == resource.data.activitySource
          && request.resource.data.challengeId == resource.data.challengeId
          && request.resource.data.expiresAtMs == resource.data.expiresAtMs
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount'])
          && (
            request.resource.data.memberCount == resource.data.memberCount + 1
            || request.resource.data.memberCount == resource.data.memberCount - 1
          )
          && request.resource.data.memberCount >= 0
          && request.resource.data.memberCount <= request.resource.data.maxPlayers
          && (
            (
              request.resource.data.memberCount == resource.data.memberCount + 1
              && getAfter(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)).exists()
            )
            || (
              request.resource.data.memberCount == resource.data.memberCount - 1
              && !getAfter(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)).exists()
            )
          )
        )
      );
      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;
      match /members/{memberUid} {
        allow read: if signedIn();
        allow create: if owner(memberUid)
          && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.status == 'open'
          && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.memberCount < getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.maxPlayers;
        allow delete: if owner(memberUid);
        allow update: if false;
      }
      match /messages/{messageId} {
        allow read: if signedIn() && exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid && exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)) && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500;
        allow update, delete: if false;
      }
      match /state/{stateId} {
        allow read: if signedIn()
          && exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
        allow create, update: if signedIn()
          && exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid))
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.state is map
          && request.resource.data.state.size() <= 30
          && request.resource.data.version is number
          && request.resource.data.updatedAtMs is number
          && request.resource.data.activityId is string
          && request.resource.data.activityId.size() > 0
          && request.resource.data.activityId.size() <= 80
          && request.resource.data.activityId == get(/databases/$(database)/documents/rooms/$(roomId)).data.challengeId
          && request.resource.data.mechanic in ['order','allocate','grid','assign','shared-puzzle','shared-learn','shared-challenge'];
        allow delete: if signedIn()
          && get(/databases/$(database)/documents/rooms/$(roomId)).data.hostUid == request.auth.uid;
      }
    }

  }}
